# ==========================================
# RAG TELEGRAM BOT - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Database (PostgreSQL)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_secure_pass123
POSTGRES_DB=n8n
POSTGRES_PORT=5435

# 2. Redis (Queue Broker)
REDIS_PASSWORD=redis_secure_pass123
REDIS_PORT=6379

# 3. n8n Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# Sesuaikan WEBHOOK_URL dengan URL Cloudflare Tunnel publik Anda, misalnya: https://bot.domainanda.com/
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace_with_a_secure_32_char_key_123456
GENERIC_TIMEZONE=Asia/Jakarta

# 4. Telegram Bot Configuration
# Dapatkan token dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# ID Telegram admin untuk whitelist upload ingestion (dapatkan via @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=123456789

# 5. LLM API (Google Gemini)
# Dapatkan API Key gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sk-cos-7WVXrRdtWsD9XTaXZM9-HgrJR5uEK3htsyMLd4J6X9Q
GEMINI_MODEL=gemini-flash-lite-latest

# 6. Embedding API (Hugging Face)
# Dapatkan user access token di https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# 7. Vector Database (Qdrant)
# Jika menggunakan Qdrant lokal dari docker-compose:
QDRANT_HOST=http://localhost:6333
# Jika di dalam n8n container, gunakan: http://qdrant:6333
QDRANT_CONTAINER_HOST=http://qdrant:6333
# Jika menggunakan Qdrant Cloud: isi URL cluster dan API Key
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# 8. Cloudflare Tunnel (Opsional untuk public exposure)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflared_token_here
