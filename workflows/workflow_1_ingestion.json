{
  "name": "Workflow 1 - Document Ingestion (Admin Only)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "node-tg-trigger",
      "name": "Telegram Trigger (Doc Upload)",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "webhookId": "tg-ingestion-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-admin",
              "leftValue": "={{ $json.message?.from?.id?.toString() }}",
              "rightValue": "={{ $env.TELEGRAM_ADMIN_CHAT_ID }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-admin-check",
      "name": "Check Admin Whitelist (FR-9)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "⛔ *Akses Ditolak*\n\nHanya Administrator terdaftar yang diizinkan mengunggah dokumen baru ke Knowledge Base bersama.",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_to_message_id": "={{ $json.message.message_id }}"
        }
      },
      "id": "node-deny-msg",
      "name": "Send Access Denied",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        680,
        460
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-doc",
              "leftValue": "={{ $json.message?.document?.file_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-check-doc",
      "name": "Has Document Attached?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        220
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "⚠️ Harap lampirkan file PDF atau TXT untuk di-ingest ke Knowledge Base.",
        "additionalFields": {
          "reply_to_message_id": "={{ $json.message.message_id }}"
        }
      },
      "id": "node-no-doc-msg",
      "name": "Prompt For File",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        920,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-size",
              "leftValue": "={{ $json.message?.document?.file_size || 0 }}",
              "rightValue": 20971520,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-check-size",
      "name": "Is File <= 20MB?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        920,
        140
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "=⚠️ *Ukuran File Terlalu Besar*\n\nFile `{{ $json.message.document.file_name }}` berukuran *{{ ($json.message.document.file_size / 1048576).toFixed(1) }} MB*.\n\nTelegram Bot API membatasi download file otomatis maksimal *20 MB*.\n\n💡 *Solusi:*\n1. Kompres file PDF Anda (misal via ilovepdf.com) agar di bawah 20 MB lalu kirim ulang, atau\n2. Letakkan file langsung ke folder `Sumber_Data/` di server lalu jalankan skrip embedding lokal.",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_to_message_id": "={{ $json.message.message_id }}"
        }
      },
      "id": "node-file-too-big-msg",
      "name": "Send File Too Big Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1160,
        260
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "get",
        "fileId": "={{ $json.message.document.file_id }}",
        "download": true
      },
      "id": "node-get-file",
      "name": "Download Telegram Document",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1160,
        60
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "qdrantCollection": "={{ $env.QDRANT_COLLECTION || 'knowledge_base' }}",
        "options": {}
      },
      "id": "node-qdrant-insert",
      "name": "Qdrant Vector Store (FR-2)",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1,
      "position": [
        1220,
        140
      ]
    },
    {
      "parameters": {
        "modelName": "sentence-transformers/all-MiniLM-L6-v2"
      },
      "id": "node-hf-embeddings",
      "name": "Embeddings HuggingFace (384-dim)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsHuggingFaceInference",
      "typeVersion": 1,
      "position": [
        1140,
        360
      ]
    },
    {
      "parameters": {
        "dataType": "binary",
        "binaryPropertyName": "data",
        "options": {}
      },
      "id": "node-doc-loader",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1,
      "position": [
        1300,
        360
      ]
    },
    {
      "parameters": {
        "chunkSize": 1000,
        "chunkOverlap": 100
      },
      "id": "node-text-splitter",
      "name": "Recursive Character Text Splitter (FR-1)",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        1440,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst triggerData = $('Telegram Trigger (Doc Upload)').first().json;\n\nreturn [{\n  json: {\n    total_chunks: items.length,\n    file_name: triggerData.message?.document?.file_name || 'Dokumen',\n    chat_id: triggerData.message.chat.id,\n    message_id: triggerData.message.message_id\n  }\n}];"
      },
      "id": "node-aggregate-chunks",
      "name": "Aggregate to Single Item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        140
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "=✅ *Ingestion Berhasil!*\n\nDokumen `{{ $json.file_name }}` telah berhasil diproses (total {{ $json.total_chunks }} chunks) dan di-embed ke Qdrant Vector Store (`{{ $env.QDRANT_COLLECTION || 'knowledge_base' }}`).\n\nBot Telegram sekarang sudah dapat menjawab pertanyaan berbasis dokumen tersebut.",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_to_message_id": "={{ $json.message_id }}"
        }
      },
      "id": "node-success-msg",
      "name": "Send Success Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "executeOnce": true,
      "position": [
        1700,
        140
      ]
    }
  ],
  "connections": {
    "Telegram Trigger (Doc Upload)": {
      "main": [
        [
          {
            "node": "Check Admin Whitelist (FR-9)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Admin Whitelist (FR-9)": {
      "main": [
        [
          {
            "node": "Has Document Attached?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Access Denied",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Document Attached?": {
      "main": [
        [
          {
            "node": "Is File <= 20MB?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Prompt For File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is File <= 20MB?": {
      "main": [
        [
          {
            "node": "Download Telegram Document",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send File Too Big Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Telegram Document": {
      "main": [
        [
          {
            "node": "Qdrant Vector Store (FR-2)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings HuggingFace (384-dim)": {
      "ai_embedding": [
        [
          {
            "node": "Qdrant Vector Store (FR-2)",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Default Data Loader": {
      "ai_document": [
        [
          {
            "node": "Qdrant Vector Store (FR-2)",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "Recursive Character Text Splitter (FR-1)": {
      "ai_textSplitter": [
        [
          {
            "node": "Default Data Loader",
            "type": "ai_textSplitter",
            "index": 0
          }
        ]
      ]
    },
    "Qdrant Vector Store (FR-2)": {
      "main": [
        [
          {
            "node": "Aggregate to Single Item",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate to Single Item": {
      "main": [
        [
          {
            "node": "Send Success Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}
